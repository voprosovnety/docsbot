# --- Required ---------------------------------------------------------------

# Bot token from @BotFather
BOT_TOKEN=

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Set automatically by docker compose. Only needed when running the bot locally
# against your own PostgreSQL:
# DATABASE_URL=postgresql://docsbot:docsbot@localhost:5432/docsbot

# --- Optional ---------------------------------------------------------------

# Comma-separated Telegram user IDs allowed to run /reset.
# Leave empty to let anyone reset their own chat's documents.
ADMIN_IDS=

# Claude model and reasoning effort (low | medium | high | xhigh | max).
# "low" keeps answers fast; raise it if your documents need deeper reasoning.
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=low

# Retrieval tuning.
# TOP_K          how many excerpts to send to the model
# MAX_DISTANCE   cosine distance cutoff — lower is stricter, and a stricter
#                cutoff means more "I don't know" instead of a loose answer.
#                0.40 is measured against the sample documents: on-topic
#                questions score 0.19-0.33, off-topic ones 0.47-0.61.
#                Re-measure if you change EMBEDDING_MODEL.
TOP_K=5
MAX_DISTANCE=0.40

# Chunking, in characters.
CHUNK_SIZE=700
CHUNK_OVERLAP=150

# Upload limit in megabytes.
MAX_FILE_MB=20

LOG_LEVEL=INFO

# --- PostgreSQL (docker compose) --------------------------------------------
POSTGRES_USER=docsbot
POSTGRES_PASSWORD=docsbot
POSTGRES_DB=docsbot
